<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>SoftwareFirst.Switchboard</PackageId>
    <Version>1.3.0</Version>
    <PackageReleaseNotes>The request handler is now resolved inside the pipeline, as in MediatR: behaviors run before the handler is constructed, a request a behavior rejects or answers never constructs its handler, and a missing or unconstructible handler fails where behaviors can catch, log and count it. See CHANGELOG.md for the behavior notes.</PackageReleaseNotes>
    <Authors>Software First</Authors>
    <Company>Software First</Company>
    <Copyright>Copyright © Software First</Copyright>
    <Description>A lightweight, MediatR-compatible mediator for .NET. Requests, notifications and pipeline behaviors resolved from Microsoft.Extensions.DependencyInjection — a drop-in replacement for the MediatR surface most applications actually use. Targets the latest .NET (net11.0), with no package dependencies.</Description>
    <PackageTags>mediator;mediatr;mediatr-alternative;cqrs;request;response;notification;pipeline;behavior;dependency-injection</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Software-First-Gr/Switchboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Software-First-Gr/Switchboard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Label="Build quality">
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Pack fails on any binary breaking change against the last published package. After each release,
      move this to the version just shipped and delete CompatibilitySuppressions.xml.
    -->
    <PackageValidationBaselineVersion>1.3.0</PackageValidationBaselineVersion>
    <ApiCompatEnableRuleCannotChangeParameterName>true</ApiCompatEnableRuleCannotChangeParameterName>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Compiled with runtime-native async, as the .NET 11 libraries themselves are.
    Every async method in the dispatch path (Send, Publish, the scope-per-dispatch wrapper, telemetry) is then
    suspended and resumed by the runtime instead of a compiler-generated state machine: no state-machine box per
    awaited dispatch, and live stack traces (profilers, the debugger, new StackTrace()) show the handler, the
    behaviors and the mediator frames without AsyncMethodBuilderCore noise in between.
    RuntimeAsyncTests asserts it is on; set UseRuntimeAsync=false to build without it.
  -->
  <PropertyGroup Condition="'$(UseRuntimeAsync)' != 'false'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Switchboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    No package references: from .NET 11, Microsoft.Extensions.DependencyInjection.Abstractions ships in the shared
    framework (Microsoft.NETCore.App), so the package has no dependencies and never moves an app onto a newer one.
  -->

</Project>
