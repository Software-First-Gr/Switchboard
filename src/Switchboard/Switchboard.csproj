<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>SoftwareFirst.Switchboard</PackageId>
    <Version>1.3.0</Version>
    <PackageReleaseNotes>The request handler is now resolved inside the pipeline, as in MediatR: behaviors run before the handler is constructed, a request a behavior rejects or answers never constructs its handler, and a missing or unconstructible handler fails where behaviors can catch, log and count it. See CHANGELOG.md for the behavior notes.</PackageReleaseNotes>
    <Authors>Software First</Authors>
    <Company>Software First</Company>
    <Copyright>Copyright © Software First</Copyright>
    <Description>A lightweight, MediatR-compatible mediator for .NET. Requests, notifications and pipeline behaviors resolved from Microsoft.Extensions.DependencyInjection — a drop-in replacement for the MediatR surface most applications actually use. Targets net8.0, net9.0, net10.0 and net11.0 with a single dependency.</Description>
    <PackageTags>mediator;mediatr;mediatr-alternative;cqrs;request;response;notification;pipeline;behavior;dependency-injection</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Software-First-Gr/Switchboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Software-First-Gr/Switchboard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Label="Build quality">
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Pack fails on any binary breaking change against the last published package. After each release,
      move this to the version just shipped and delete CompatibilitySuppressions.xml.
    -->
    <PackageValidationBaselineVersion>1.3.0</PackageValidationBaselineVersion>
    <ApiCompatEnableRuleCannotChangeParameterName>true</ApiCompatEnableRuleCannotChangeParameterName>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    .NET 11: the net11.0 build is compiled with runtime-native async, as the .NET 11 libraries themselves are.
    Every async method in the dispatch path (Send, Publish, the scope-per-dispatch wrapper, telemetry) is then
    suspended and resumed by the runtime instead of a compiler-generated state machine: no state-machine box per
    awaited dispatch, and live stack traces (profilers, the debugger, new StackTrace()) show the handler, the
    behaviors and the mediator frames without AsyncMethodBuilderCore noise in between. Older targets are unchanged.
    RuntimeAsyncTests asserts it is on; set UseRuntimeAsync=false to build without it.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0' and '$(UseRuntimeAsync)' != 'false'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Switchboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The minimum is the latest tested servicing patch for each target's Microsoft.Extensions major.
    Consumers pinned below that floor may be upgraded to it.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
  </ItemGroup>

</Project>
