<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>SoftwareFirst.Switchboard</PackageId>
    <Version>2.0.0</Version>
    <PackageReleaseNotes>2.0 targets the latest .NET only (net11.0); apps on .NET 8, 9 or 10 stay on 1.x. New: streaming requests with MediatR's API (IStreamRequest, IStreamRequestHandler, IStreamPipelineBehavior, CreateStream), and no package dependencies. The API is otherwise unchanged from 1.3. See CHANGELOG.md.</PackageReleaseNotes>
    <Authors>Software First</Authors>
    <Company>Software First</Company>
    <Copyright>Copyright © Software First</Copyright>
    <Description>A lightweight, MediatR-compatible mediator for .NET. Requests, notifications and pipeline behaviors resolved from Microsoft.Extensions.DependencyInjection — a drop-in replacement for the MediatR surface most applications actually use. Targets the latest .NET (net11.0), with no package dependencies.</Description>
    <PackageTags>mediator;mediatr;mediatr-alternative;cqrs;request;response;notification;pipeline;behavior;dependency-injection</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Software-First-Gr/Switchboard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Software-First-Gr/Switchboard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Label="Build quality">
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Pack fails on any binary breaking change against the last published package. After each release,
      move this to the version just shipped and delete CompatibilitySuppressions.xml.
    -->
    <PackageValidationBaselineVersion>2.0.0</PackageValidationBaselineVersion>
    <ApiCompatEnableRuleCannotChangeParameterName>true</ApiCompatEnableRuleCannotChangeParameterName>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Runtime-native async (.NET 11, preview) is off: measured, it made Switchboard no faster and allocated more whenever
    a dispatch suspends, because every behavior's next() is a delegate, the one call shape that forces runtime async
    back onto classic Tasks (tools/README.md, "Runtime-async study"). UseRuntimeAsync=true builds with it, for the
    study; RuntimeAsyncTests asserts the shipped build has it off.
  -->
  <PropertyGroup Condition="'$(UseRuntimeAsync)' == 'true'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Switchboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    No package references: from .NET 11, Microsoft.Extensions.DependencyInjection.Abstractions ships in the shared
    framework (Microsoft.NETCore.App), so the package has no dependencies and never moves an app onto a newer one.
  -->

</Project>
